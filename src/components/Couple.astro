<section id="couple" class="py-20 px-4 max-w-5xl mx-auto text-center">
  <div class="mb-16">
    <span class="text-sm sm:text-base uppercase tracking-[0.3em] text-[#8C6010] font-bold">Maha Suci Allah</span>
    <h2 class="font-serif-luxury text-3xl sm:text-4xl md:text-5xl text-[#1A202C] mt-2 mb-4 font-bold">
      Pasangan Mempelai
    </h2>
    <p class="max-w-xl mx-auto text-base sm:text-lg text-gray-700 font-medium leading-relaxed">
      Dengan memohon rahmat dan ridho Allah SWT, kami bermaksud menyelenggarakan syukuran pernikahan putra-putri kami:
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-14 items-center">
    <!-- Groom -->
    <div class="flex flex-col items-center bg-white/90 backdrop-blur-sm p-8 sm:p-10 rounded-3xl border-2 border-[#D4AF37]/40 shadow-md hover:shadow-xl transition-all duration-300 group">
      <div class="relative w-52 h-52 sm:w-60 sm:h-60 mb-6">
        <div class="absolute inset-0 rounded-full border-2 border-dashed border-[#D4AF37] animate-spin-slow"></div>
        <img
          src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=600&auto=format&fit=crop"
          alt="Bagas Pratama"
          class="w-full h-full object-cover rounded-full p-2"
        />
      </div>

      <h3 class="font-serif-luxury text-3xl sm:text-4xl font-bold text-[#1A202C] mb-2">
        Muhammad Fikri Baihaqi S.Kom.
      </h3>
      <p class="text-sm sm:text-base uppercase tracking-wider text-[#8C6010] font-bold mb-5">Mempelai Pria</p>
      
      <p class="text-base sm:text-lg text-gray-800 leading-relaxed mb-6">
        Putra ketiga dari pasangan<br />
        <strong class="text-[#1A202C] text-lg sm:text-xl font-bold block mt-1">(Alm) Bpk. Lukman Hakim Priyono</strong>
        <span class="text-sm text-gray-500 font-semibold">&</span>
        <strong class="text-[#1A202C] text-lg sm:text-xl font-bold block">Ibu Nurcendrawati</strong>
      </p>

      <a
        href="https://instagram.com/alhaqii_19"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm font-bold text-[#8C6010] bg-[#D4AF37]/20 hover:bg-[#D4AF37]/30 px-5 py-2.5 rounded-full transition-colors border border-[#D4AF37]/40"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37zm1.5-4.87h.01M6.5 2h11A4.5 4.5 0 0122 6.5v11a4.5 4.5 0 01-4.5 4.5h-11A4.5 4.5 0 012 17.5v-11A4.5 4.5 0 016.5 2z" />
        </svg>
        <span>@alhaqii_19</span>
      </a>
    </div>

    <!-- Bride -->
    <div class="flex flex-col items-center bg-white/90 backdrop-blur-sm p-8 sm:p-10 rounded-3xl border-2 border-[#D4AF37]/40 shadow-md hover:shadow-xl transition-all duration-300 group">
      <div class="relative w-52 h-52 sm:w-60 sm:h-60 mb-6">
        <div class="absolute inset-0 rounded-full border-2 border-dashed border-[#D4AF37] animate-spin-slow"></div>
        <img
          src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=600&auto=format&fit=crop"
          alt="Sarah Amelia"
          class="w-full h-full object-cover rounded-full p-2"
        />
      </div>

      <h3 class="font-serif-luxury text-3xl sm:text-4xl font-bold text-[#1A202C] mb-2">
        ???????????
      </h3>
      <p class="text-sm sm:text-base uppercase tracking-wider text-[#8C6010] font-bold mb-5">Mempelai Wanita</p>
      
      <p class="text-base sm:text-lg text-gray-800 leading-relaxed mb-6">
        Putri ke??? dari pasangan<br />
        <strong class="text-[#1A202C] text-lg sm:text-xl font-bold block mt-1">Bpk. ???????????</strong>
        <span class="text-sm text-gray-500 font-semibold">&</span>
        <strong class="text-[#1A202C] text-lg sm:text-xl font-bold block">Ibu ???????????</strong>
      </p>

      <a
        href="https://instagram.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm font-bold text-[#8C6010] bg-[#D4AF37]/20 hover:bg-[#D4AF37]/30 px-5 py-2.5 rounded-full transition-colors border border-[#D4AF37]/40"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37zm1.5-4.87h.01M6.5 2h11A4.5 4.5 0 0122 6.5v11a4.5 4.5 0 01-4.5 4.5h-11A4.5 4.5 0 012 17.5v-11A4.5 4.5 0 016.5 2z" />
        </svg>
        <span>@?????????</span>
      </a>
    </div>
  </div>
</section>
