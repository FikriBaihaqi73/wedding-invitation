---
---

<section id="event" class="py-20 px-4 bg-[#F5EFE6]/70 border-y border-[#E8DFC8]">
  <div class="max-w-5xl mx-auto text-center">
    <span class="text-sm sm:text-base uppercase tracking-[0.3em] text-[#8C6010] font-bold">Waktu & Tempat</span>
    <h2 class="font-serif-luxury text-3xl sm:text-4xl md:text-5xl text-[#1A202C] mt-2 mb-4 font-bold">
      Rangkaian Acara
    </h2>
    <p class="max-w-xl mx-auto text-base sm:text-lg text-gray-700 font-medium mb-14">
      Insya Allah rangkaian acara pernikahan kami akan diselenggarakan pada:
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-left">
      <!-- Akad Nikah Card -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 border-2 border-[#D4AF37]/40 shadow-md relative overflow-hidden flex flex-col justify-between">
        <div class="absolute top-0 right-0 bg-[#D4AF37] text-white text-xs uppercase font-extrabold tracking-widest px-5 py-2 rounded-bl-2xl shadow-sm">
          Akad Nikah
        </div>

        <div>
          <div class="flex items-center gap-4 mb-6">
            <div class="w-14 h-14 rounded-2xl bg-[#D4AF37]/20 flex items-center justify-center text-[#8C6010] shadow-inner">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h3 class="font-serif-luxury text-2xl sm:text-3xl font-bold text-[#1A202C]">Akad Nikah</h3>
              <p class="text-sm font-semibold text-gray-500">Khusus Keluarga & Kerabat</p>
            </div>
          </div>

          <div class="space-y-4 text-base sm:text-lg text-gray-800 mb-8 font-medium">
            <div class="flex items-start gap-3 bg-[#FAF7F2] p-3.5 rounded-xl border border-[#E8DFC8]">
              <span class="text-[#8C6010] font-bold shrink-0">📅 Hari/Tgl:</span>
              <span class="font-bold text-[#1A202C]">Minggu, 25 Oktober 2026</span>
            </div>
            <div class="flex items-start gap-3 bg-[#FAF7F2] p-3.5 rounded-xl border border-[#E8DFC8]">
              <span class="text-[#8C6010] font-bold shrink-0">⏰ Waktu:</span>
              <span class="font-bold text-[#1A202C]">08.00 - 10.00 WIB</span>
            </div>
            <div class="flex items-start gap-3 bg-[#FAF7F2] p-3.5 rounded-xl border border-[#E8DFC8]">
              <span class="text-[#8C6010] font-bold shrink-0">📍 Tempat:</span>
              <span class="leading-relaxed">Masjid Raya Al-Ikhlas, Jl. Melati No. 45, Jakarta Selatan</span>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap gap-3">
          <a
            href="https://maps.google.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-[#1A202C] hover:bg-[#8C6010] text-white text-sm sm:text-base font-bold transition-all shadow-md active:scale-98 cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FFD700]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Petunjuk Arah Google Maps</span>
          </a>
        </div>
      </div>

      <!-- Resepsi Card -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 border-2 border-[#D4AF37]/40 shadow-md relative overflow-hidden flex flex-col justify-between">
        <div class="absolute top-0 right-0 bg-[#8C6010] text-white text-xs uppercase font-extrabold tracking-widest px-5 py-2 rounded-bl-2xl shadow-sm">
          Resepsi Pernikahan
        </div>

        <div>
          <div class="flex items-center gap-4 mb-6">
            <div class="w-14 h-14 rounded-2xl bg-[#D4AF37]/20 flex items-center justify-center text-[#8C6010] shadow-inner">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 15.546c-.523 0-1.046.151-1.5.454a2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-3 0 2.704 2.704 0 00-3 0 2.704 2.704 0 01-3 0 2.701 2.701 0 00-1.5-.454M9 6v2m3-2v2m3-2v2M9 3h.01M12 3h.01M15 3h.01M21 21v-7a2 2 0 00-2-2H5a2 2 0 00-2 2v7h18zm-3-9v-2a2 2 0 00-2-2H8a2 2 0 00-2 2v2h10z" />
              </svg>
            </div>
            <div>
              <h3 class="font-serif-luxury text-2xl sm:text-3xl font-bold text-[#1A202C]">Resepsi</h3>
              <p class="text-sm font-semibold text-gray-500">Sesi Ramah Tamah</p>
            </div>
          </div>

          <div class="space-y-4 text-base sm:text-lg text-gray-800 mb-8 font-medium">
            <div class="flex items-start gap-3 bg-[#FAF7F2] p-3.5 rounded-xl border border-[#E8DFC8]">
              <span class="text-[#8C6010] font-bold shrink-0">📅 Hari/Tgl:</span>
              <span class="font-bold text-[#1A202C]">Minggu, 25 Oktober 2026</span>
            </div>
            <div class="flex items-start gap-3 bg-[#FAF7F2] p-3.5 rounded-xl border border-[#E8DFC8]">
              <span class="text-[#8C6010] font-bold shrink-0">⏰ Waktu:</span>
              <span class="font-bold text-[#1A202C]">11.00 - 16.00 WIB</span>
            </div>
            <div class="flex items-start gap-3 bg-[#FAF7F2] p-3.5 rounded-xl border border-[#E8DFC8]">
              <span class="text-[#8C6010] font-bold shrink-0">📍 Tempat:</span>
              <span class="leading-relaxed">Grand Ballroom Hotel Mulia Senayan, Jakarta</span>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap gap-3">
          <a
            href="https://maps.google.com"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-[#1A202C] hover:bg-[#8C6010] text-white text-sm sm:text-base font-bold transition-all shadow-md active:scale-98 cursor-pointer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-[#FFD700]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Petunjuk Arah Google Maps</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
