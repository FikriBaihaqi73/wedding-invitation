---
---

<section id="gift" class="py-20 px-4 max-w-4xl mx-auto text-center">
  <div class="mb-14">
    <span class="text-sm sm:text-base uppercase tracking-[0.3em] text-[#8C6010] font-bold">Tanda Kasih</span>
    <h2 class="font-serif-luxury text-3xl sm:text-4xl md:text-5xl text-[#1A202C] mt-2 mb-4 font-bold">
      Amplop Digital & Kado
    </h2>
    <p class="max-w-md mx-auto text-base sm:text-lg text-gray-700 font-medium leading-relaxed">
      Doa restu Anda merupakan karunia terindah bagi kami. Namun jika ingin memberikan tanda kasih, Anda dapat menyalurkannya melalui:
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-2xl mx-auto mb-10">
    <!-- Bank BCA Card -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border-2 border-[#D4AF37]/40 shadow-md flex flex-col items-center justify-between text-center relative overflow-hidden">
      <div class="w-full flex justify-between items-center mb-6">
        <span class="font-black text-2xl tracking-wider text-[#0060AF]">BCA</span>
        <span class="text-xs uppercase font-bold text-gray-500">Bank Central Asia</span>
      </div>

      <div class="my-3">
        <p class="text-xs sm:text-sm text-gray-500 uppercase tracking-wider mb-1 font-bold">Nomor Rekening</p>
        <p id="bca-number" class="text-2xl sm:text-3xl font-extrabold font-mono text-[#1A202C] tracking-widest bg-[#FAF7F2] py-2 px-3 rounded-xl border border-[#E8DFC8]">
          8830 1928 44
        </p>
        <p class="text-sm sm:text-base font-bold text-[#8C6010] mt-2">a.n Bagas Pratama</p>
      </div>

      <button
        type="button"
        data-copy="8830192844"
        class="btn-copy mt-6 w-full py-3.5 px-5 rounded-2xl bg-[#FAF7F2] hover:bg-[#8C6010] hover:text-white border-2 border-[#D4AF37]/50 text-sm font-bold text-[#1A202C] transition-all flex items-center justify-center gap-2 cursor-pointer shadow-sm active:scale-98"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
        </svg>
        <span>Salin No. Rekening</span>
      </button>
    </div>

    <!-- Bank Mandiri Card -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border-2 border-[#D4AF37]/40 shadow-md flex flex-col items-center justify-between text-center relative overflow-hidden">
      <div class="w-full flex justify-between items-center mb-6">
        <span class="font-black text-2xl tracking-wider text-[#003D79]">MANDIRI</span>
        <span class="text-xs uppercase font-bold text-gray-500">Bank Mandiri</span>
      </div>

      <div class="my-3">
        <p class="text-xs sm:text-sm text-gray-500 uppercase tracking-wider mb-1 font-bold">Nomor Rekening</p>
        <p id="mandiri-number" class="text-2xl sm:text-3xl font-extrabold font-mono text-[#1A202C] tracking-widest bg-[#FAF7F2] py-2 px-3 rounded-xl border border-[#E8DFC8]">
          137 00 9821 002
        </p>
        <p class="text-sm sm:text-base font-bold text-[#8C6010] mt-2">a.n Sarah Amelia</p>
      </div>

      <button
        type="button"
        data-copy="137009821002"
        class="btn-copy mt-6 w-full py-3.5 px-5 rounded-2xl bg-[#FAF7F2] hover:bg-[#8C6010] hover:text-white border-2 border-[#D4AF37]/50 text-sm font-bold text-[#1A202C] transition-all flex items-center justify-center gap-2 cursor-pointer shadow-sm active:scale-98"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
        </svg>
        <span>Salin No. Rekening</span>
      </button>
    </div>
  </div>

  <!-- Toast Notification -->
  <div id="copy-toast" class="fixed bottom-24 left-1/2 -translate-x-1/2 bg-[#1A1817] text-[#FFD700] px-7 py-3 rounded-full text-sm font-bold shadow-2xl opacity-0 pointer-events-none transition-all duration-300 z-50 flex items-center gap-2 border border-[#D4AF37]/50">
    <span>✨ Nomor rekening berhasil disalin!</span>
  </div>
</section>

<script>
  const copyButtons = document.querySelectorAll('.btn-copy');
  const toast = document.getElementById('copy-toast');

  copyButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const textToCopy = btn.getAttribute('data-copy');
      if (textToCopy) {
        navigator.clipboard.writeText(textToCopy).then(() => {
          if (toast) {
            toast.classList.remove('opacity-0', 'pointer-events-none');
            toast.classList.add('opacity-100');
            setTimeout(() => {
              toast.classList.remove('opacity-100');
              toast.classList.add('opacity-0', 'pointer-events-none');
            }, 2500);
          }
        });
      }
    });
  });
</script>
