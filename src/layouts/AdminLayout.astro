---
import Layout from './Layout.astro';

interface Props {
  title: string;
  activeTab: 'dashboard' | 'guests' | 'wishes';
}

const { title, activeTab } = Astro.props;

const navItems = [
  { id: 'dashboard', label: 'Dashboard', href: '/admin', icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>' },
  { id: 'guests', label: 'Tamu', href: '/admin/guests', icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>' },
  { id: 'wishes', label: 'Ucapan', href: '/admin/wishes', icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>' }
];
---
<Layout title={`${title} - Admin`}>
  <div class="min-h-screen bg-gray-50 flex">
    <!-- Sidebar -->
    <aside class="w-64 bg-white border-r border-gray-100 flex flex-col hidden md:flex fixed h-full z-10">
      <div class="p-6">
        <h1 class="text-2xl font-serif font-bold text-[#2D3748] tracking-tight text-center">Admin Panel</h1>
      </div>
      <nav class="flex-1 px-4 space-y-2 mt-6">
        {navItems.map(item => (
          <a 
            href={item.href} 
            class={`flex items-center gap-3 px-4 py-3 rounded-xl transition-all ${
              activeTab === item.id 
                ? 'bg-[#FAF7F2] text-[#D4AF37] font-semibold shadow-sm' 
                : 'text-gray-500 hover:bg-gray-50 hover:text-gray-900'
            }`}
          >
            <span set:html={item.icon} />
            {item.label}
          </a>
        ))}
      </nav>
      <div class="p-4 border-t border-gray-100">
        <form method="POST" action="/admin/logout">
          <button type="submit" class="flex w-full items-center justify-center gap-2 px-4 py-3 text-red-600 hover:bg-red-50 rounded-xl transition-colors font-medium">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
            Keluar
          </button>
        </form>
      </div>
    </aside>

    <!-- Mobile Header (Visible on small screens) -->
    <div class="md:hidden fixed top-0 w-full bg-white border-b border-gray-100 z-20 px-4 py-3 flex justify-between items-center">
      <h1 class="text-xl font-serif font-bold text-[#2D3748]">Admin Panel</h1>
      <form method="POST" action="/admin/logout">
        <button type="submit" class="p-2 text-red-600 hover:bg-red-50 rounded-lg">
           <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
        </button>
      </form>
    </div>
    
    <!-- Mobile Nav -->
    <div class="md:hidden fixed bottom-0 w-full bg-white border-t border-gray-100 z-20 flex justify-around p-2">
      {navItems.map(item => (
        <a 
          href={item.href} 
          class={`flex flex-col items-center gap-1 p-2 rounded-lg ${
            activeTab === item.id ? 'text-[#D4AF37]' : 'text-gray-500'
          }`}
        >
          <span set:html={item.icon} />
          <span class="text-[10px] font-medium">{item.label}</span>
        </a>
      ))}
    </div>

    <!-- Main Content -->
    <main class="flex-1 md:ml-64 p-4 sm:p-8 pt-20 md:pt-8 pb-24 md:pb-8">
      <slot />
    </main>
  </div>
</Layout>
