---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  guestName?: string;
}

const { 
  title = "The Wedding of Bagas & Sarah", 
  description = "Kami mengundang Anda untuk merayakan momen bahagia pernikahan kami.",
  guestName
} = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{guestName ? `Undangan untuk ${guestName} - ${title}` : title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
	</head>
	<body class="bg-[#FAF7F2] text-[#2D3748] antialiased selection:bg-[#D4AF37] selection:text-white">
		<slot />
	</body>
</html>

