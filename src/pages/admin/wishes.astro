---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db } from '../../db';
import { guests, comments } from '../../db/schema';
import { desc, eq } from 'drizzle-orm';

const allComments = await db.select({
  id: comments.id,
  message: comments.message,
  attendance: comments.attendance,
  createdAt: comments.createdAt,
  guestName: guests.name,
}).from(comments)
  .leftJoin(guests, eq(comments.guestId, guests.id))
  .orderBy(desc(comments.createdAt));

const hadirCount = allComments.filter(c => c.attendance === 'hadir').length;
const tidakHadirCount = allComments.filter(c => c.attendance === 'tidak_hadir').length;
const raguCount = allComments.filter(c => c.attendance !== 'hadir' && c.attendance !== 'tidak_hadir').length;
---

<AdminLayout title="Ucapan Tamu" activeTab="wishes">
  <div class="space-y-8 max-w-5xl mx-auto">
    <header>
      <h1 class="text-3xl font-serif text-[#2D3748] tracking-tight">Ucapan & Kehadiran</h1>
      <p class="text-gray-500 mt-2 font-medium">Pantau ucapan dan status kehadiran tamu.</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="bg-green-50 border border-green-100 rounded-2xl p-6 flex items-center justify-between">
        <div>
          <p class="text-green-600 font-medium text-sm">Hadir</p>
          <h2 class="text-3xl font-bold text-green-700">{hadirCount}</h2>
        </div>
        <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center text-green-600">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg>
        </div>
      </div>
      <div class="bg-red-50 border border-red-100 rounded-2xl p-6 flex items-center justify-between">
        <div>
          <p class="text-red-600 font-medium text-sm">Tidak Hadir</p>
          <h2 class="text-3xl font-bold text-red-700">{tidakHadirCount}</h2>
        </div>
        <div class="w-12 h-12 bg-red-100 rounded-full flex items-center justify-center text-red-600">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </div>
      </div>
      <div class="bg-yellow-50 border border-yellow-100 rounded-2xl p-6 flex items-center justify-between">
        <div>
          <p class="text-yellow-600 font-medium text-sm">Ragu-ragu / Lainnya</p>
          <h2 class="text-3xl font-bold text-yellow-700">{raguCount}</h2>
        </div>
        <div class="w-12 h-12 bg-yellow-100 rounded-full flex items-center justify-center text-yellow-600">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden">
      <div class="p-6 border-b border-gray-50 flex justify-between items-center bg-gray-50/50">
        <h2 class="font-bold text-lg text-[#2D3748]">Semua Ucapan ({allComments.length})</h2>
      </div>
      <div class="p-6">
        {allComments.length === 0 ? (
          <div class="py-12 text-center text-gray-400">Belum ada ucapan dari tamu.</div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {allComments.map(c => (
              <div class="p-6 rounded-2xl border border-gray-100 bg-white shadow-sm hover:shadow-md transition-all relative overflow-hidden group">
                <div class={`absolute top-0 left-0 w-1 h-full ${c.attendance === 'hadir' ? 'bg-green-400' : c.attendance === 'tidak_hadir' ? 'bg-red-400' : 'bg-yellow-400'}`}></div>
                <div class="flex justify-between items-start mb-4 pl-3">
                  <div>
                    <h3 class="font-bold text-[#2D3748]">{c.guestName || 'Tamu Anonim'}</h3>
                    <p class="text-xs text-gray-400 mt-1">
                      {c.createdAt ? new Date(c.createdAt).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : ''}
                    </p>
                  </div>
                  <span class={`text-[10px] px-3 py-1 rounded-full font-bold uppercase tracking-wider ${
                    c.attendance === 'hadir' ? 'bg-green-50 text-green-700' : 
                    c.attendance === 'tidak_hadir' ? 'bg-red-50 text-red-700' : 
                    'bg-yellow-50 text-yellow-700'
                  }`}>
                    {c.attendance === 'hadir' ? 'Hadir' : c.attendance === 'tidak_hadir' ? 'Tidak Hadir' : 'Ragu'}
                  </span>
                </div>
                <p class="text-gray-600 italic pl-3 leading-relaxed">"{c.message}"</p>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</AdminLayout>
