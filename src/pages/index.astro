---
import Layout from '../layouts/Layout.astro';
import OpeningCover from '../components/OpeningCover.astro';
import Hero from '../components/Hero.astro';
import Couple from '../components/Couple.astro';
import EventDetails from '../components/EventDetails.astro';
import Gallery from '../components/Gallery.astro';
import Wishes from '../components/Wishes.astro';
import Gift from '../components/Gift.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// Read query parameter if server rendered or provide default
const url = new URL(Astro.request.url);
const guestParam = url.searchParams.get('to') || url.searchParams.get('guest');
const guestName = guestParam ? decodeURIComponent(guestParam) : "Tamu Undangan";
---

<Layout title="The Wedding of Bagas & Sarah" guestName={guestName}>
  <!-- Opening Cover Overlay (Layar Pembuka & Nama Tamu) -->
  <OpeningCover guestName={guestName} />

  <!-- Floating Elements -->
  <MusicPlayer />
  <Navbar />

  <!-- Main Wedding Content -->
  <main class="min-h-screen">
    <Hero />
    <Couple />
    <EventDetails />
    <Gallery />
    <Wishes guestName={guestName !== "Tamu Undangan" ? guestName : ""} />
    <Gift />
    <Footer />
  </main>
</Layout>
