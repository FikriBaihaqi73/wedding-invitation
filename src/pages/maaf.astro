---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Maaf, Anda Tidak Terdaftar">
  <main class="min-h-screen bg-[#FAF7F2] flex items-center justify-center relative overflow-hidden px-4">
    <!-- Dekorasi Latar Belakang -->
    <div class="absolute top-0 left-0 w-full h-full pointer-events-none overflow-hidden opacity-30">
      <div class="absolute -top-[10%] -left-[10%] w-[40%] h-[40%] rounded-full bg-gradient-to-br from-[#D4AF37]/20 to-transparent blur-3xl"></div>
      <div class="absolute -bottom-[10%] -right-[10%] w-[50%] h-[50%] rounded-full bg-gradient-to-tl from-[#D4AF37]/20 to-transparent blur-3xl"></div>
    </div>

    <div class="max-w-lg w-full bg-white/70 backdrop-blur-md border border-[#E8DFC8] rounded-3xl p-8 sm:p-12 text-center shadow-2xl relative z-10 animate-fade-in-up">
      <div class="w-20 h-20 mx-auto bg-red-50 text-red-400 rounded-full flex items-center justify-center mb-6 shadow-inner border border-red-100">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      
      <h1 class="font-serif-luxury text-3xl sm:text-4xl text-[#1A202C] font-bold mb-4 leading-tight">
        Mohon Maaf
      </h1>
      
      <p class="text-gray-600 text-base sm:text-lg mb-8 leading-relaxed font-medium">
        Tautan undangan yang Anda buka tidak valid atau nama Anda belum terdaftar dalam daftar tamu undangan kami. 
      </p>

      <div class="w-16 h-[2px] bg-gradient-to-r from-transparent via-[#D4AF37] to-transparent mx-auto mb-8"></div>

      <p class="text-sm text-gray-500 mb-2">
        Jika Anda merasa ini adalah sebuah kesalahan, silakan hubungi pihak penyelenggara acara.
      </p>
    </div>
  </main>

  <style>
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .animate-fade-in-up {
      animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  </style>
</Layout>
