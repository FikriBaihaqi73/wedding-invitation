---
import Layout from '../../layouts/Layout.astro';
import OpeningCover from '../../components/OpeningCover.astro';
import Hero from '../../components/Hero.astro';
import Couple from '../../components/Couple.astro';
import EventDetails from '../../components/EventDetails.astro';
import Gallery from '../../components/Gallery.astro';
import Wishes from '../../components/Wishes.astro';
import Gift from '../../components/Gift.astro';
import MusicPlayer from '../../components/MusicPlayer.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { db } from '../../db';
import { guests } from '../../db/schema';
import { eq } from 'drizzle-orm';

export const prerender = false;

const { slug } = Astro.params;

let guestName = "Tamu Undangan";
let guestId: number | undefined = undefined;

if (slug) {
  try {
    // Try to find guest in database
    const foundGuest = await db.query.guests.findFirst({
      where: eq(guests.slug, slug),
    });

    if (foundGuest) {
      guestName = foundGuest.name;
      guestId = foundGuest.id;
    } else {
      // Guest not found in database, redirect to maaf page
      return Astro.redirect('/maaf');
    }
  } catch (err) {
    return Astro.redirect('/maaf');
  }
} else {
  return Astro.redirect('/maaf');
}
---

<Layout title="The Wedding of Bagas & Sarah" guestName={guestName}>
  <!-- Opening Cover Overlay -->
  <OpeningCover guestName={guestName} />

  <!-- Floating Elements -->
  <MusicPlayer />
  <Navbar />

  <!-- Main Wedding Content -->
  <main class="min-h-screen">
    <Hero />
    <Couple />
    <EventDetails />
    <Gallery />
    <Wishes guestName={guestName} guestId={guestId} />
    <Gift />
    <Footer />
  </main>
</Layout>
